# ------------------------------------------------------------------------------
# VSP Phone v4 — environment variables
# Copy to `.env` for local development (never commit `.env`).
# Profiles: development (default) | production (set VSP_ENV / NODE_ENV)
# ------------------------------------------------------------------------------

# --- Runtime profile ---
NODE_ENV=development
VSP_ENV=development
LOG_LEVEL=info
LOG_FORMAT=json

# --- NestJS API ---
PORT=3000
API_PORT=3000
API_GLOBAL_PREFIX=api
API_DOCKER_TARGET=development
# Phase 5 telecom contracts — shared token for Kamailio→NestJS (required in production)
TELECOM_SERVICE_AUTH_TOKEN=
# Remediation C-01 — Kamailio container refuses start when true without token
KAMAILIO_REQUIRE_SERVICE_AUTH=false
# Remediation H-06 — memory | postgres (postgres = restart-safe registrations)
KAMAILIO_USRLOC_PERSISTENCE=memory
# KAMAILIO_USRLOC_DB_URL=postgresql://vsp:vsp_dev_password@postgres:5432/kamailio?schema=public
SWAGGER_ENABLED=true

# --- SIP Auth / Registration (Phase 6) ---
SIP_PLATFORM_DOMAIN=vsp.internal
SIP_DEFAULT_EXPIRES_SEC=3600
# Lab digest password (ADR-043 vault stub). Prefer SIP_VAULT_JSON in shared labs.
SIP_DEV_PASSWORD=
# JSON map: { "<sipEndpointId>": { "password": "..." }, "user@realm": { "ha1": "..." } }
SIP_VAULT_JSON=

# --- Telnyx Carrier (Phase 8) ---
TELNYX_SIP_HOST=sip.telnyx.com
TELNYX_DISPATCHER_SET=2
# Webhook HMAC secret (unset = open stub in lab). Prefer vault in production.
TELNYX_WEBHOOK_SECRET=
# Optional REST base for future inventory calls (adapter uses config Json today)
TELNYX_API_BASE_URL=https://api.telnyx.com/v2


# --- Next.js Admin ---
ADMIN_PORT=3001
ADMIN_HOST_PORT=3001
ADMIN_DOCKER_TARGET=development
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# --- PostgreSQL ---
POSTGRES_USER=vsp
POSTGRES_PASSWORD=vsp_dev_password
POSTGRES_DB=vsp_phone
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Host-side URL (NestJS on host machine). Inside Compose, service env overrides host to `postgres`.
DATABASE_URL=postgresql://vsp:vsp_dev_password@localhost:5432/vsp_phone?schema=public

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Kamailio (Phase 1+2 listeners) ---
KAMAILIO_SIP_PORT=5060
KAMAILIO_TLS_PORT=5061
KAMAILIO_WSS_PORT=8443
KAMAILIO_WS_PORT=8080
KAMAILIO_HTTP_PORT=8880
KAMAILIO_REQUIRE_TLS=true

# --- TLS / Certificates (Phase 2) ---
# TLS_ENV selects infrastructure/tls/{development|staging|production}/live
TLS_ENV=development
# Set true to serve NestJS over HTTPS using TLS_API_* paths
TLS_ENABLED=false
API_TLS_PORT=3443
TLS_API_CERT_FILE=./infrastructure/tls/development/live/api/fullchain.pem
TLS_API_KEY_FILE=./infrastructure/tls/development/live/api/privkey.pem
TLS_CA_FILE=./infrastructure/tls/development/live/ca/ca.crt
TLS_SIP_CERT_FILE=./infrastructure/tls/development/live/sip/fullchain.pem
TLS_SIP_KEY_FILE=./infrastructure/tls/development/live/sip/privkey.pem
TLS_WSS_CERT_FILE=./infrastructure/tls/development/live/wss/fullchain.pem
TLS_WSS_KEY_FILE=./infrastructure/tls/development/live/wss/privkey.pem
TLS_PROV_CERT_FILE=./infrastructure/tls/development/live/prov/fullchain.pem
TLS_PROV_KEY_FILE=./infrastructure/tls/development/live/prov/privkey.pem
# --- Grandstream Provisioning (Phase 11) ---
PROV_HTTPS_ENABLED=true
PROV_HTTPS_PORT=3444
PROV_PUBLIC_BASE_URL=https://prov.localhost:3444
PROV_ARTIFACT_ROOT=./data/provisioning
PROV_TLS_VALIDATE=true
PROV_FIRMWARE_STABLE_VERSION=1.0.5.12
PROV_FIRMWARE_N1_VERSION=1.0.5.11
PROV_FIRMWARE_EMERGENCY_VERSION=1.0.5.10
SIP_REGISTRAR_HOST=
SIP_PORT=5061

# --- Recording Pipeline (Phase 12) ---
RECORDING_ENABLED=true
RECORDING_UPLOAD_ENABLED=true
S3_ACCESS_KEY=vspminio
S3_SECRET_KEY=vsp_minio_dev_password
S3_REGION=us-east-1
# Future: LETSENCRYPT_EMAIL=  ACME_DIRECTORY=  PKI_PROVIDER=internal|le|enterprise

# --- RTPengine (Phase 4 foundation) ---
RTPENGINE_NG_PORT=2223
RTPENGINE_CLI_PORT=2224
RTPENGINE_MEDIA_PORT_RANGE=10000-10099
RTPENGINE_LISTEN_NG=0.0.0.0:2223
RTPENGINE_INTERFACE=internal/eth0
RTPENGINE_PORT_MIN=10000
RTPENGINE_PORT_MAX=10099
RTPENGINE_LOG_LEVEL=6
# Optional public/advertise IP for NAT labs (documented for later)
RTPENGINE_ADVERTISE=

NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_WSS_URL=wss://localhost:8443

# --- WebRTC Browser (Phase 10) ---
JWT_SECRET=
JWT_ACCESS_TTL_SEC=3600
# Lab login when Prisma User unavailable (pair with seeded tenant/device)
DEV_AUTH_EMAIL=webrtc@vsp.local
DEV_AUTH_PASSWORD=webrtc-dev
DEV_AUTH_USER_ID=00000000-0000-4000-8000-000000000001
DEV_AUTH_TENANT_ID=00000000-0000-4000-8000-000000000010
WEBRTC_WSS_URL=wss://localhost:8443
WEBRTC_ENROLL_TTL_SEC=900
WEBRTC_STUN_URL=stun:stun.l.google.com:19302
# Optional TURN (coturn deferred)
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_PASSWORD=

# --- MinIO (optional: docker compose --profile extras up -d) ---
MINIO_ROOT_USER=vspminio
MINIO_ROOT_PASSWORD=vsp_minio_dev_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_RECORDINGS=vsp-recordings
S3_BUCKET_PROVISIONING=vsp-provisioning

# --- Enterprise Call Apps (Phase 13) ---
QUEUE_MEDIA_URI=sip:queue@media.vsp.internal
IVR_MEDIA_URI=sip:ivr@media.vsp.internal
CONFERENCE_MEDIA_URI=sip:conf@media.vsp.internal
VOICEMAIL_MEDIA_URI=sip:vm@media.vsp.internal
MOH_DEFAULT_URI=sip:moh@media.vsp.internal/default.wav
PROMPT_BASE_URI=sip:prompts@vsp.internal
QUEUE_WAIT_SEC=60
QUEUE_RETRY_MAX=2
# voicemail | queue:<uuid> | line:<uuid>
QUEUE_OVERFLOW_DEST=voicemail
IVR_TIMEOUT_SEC=10

# --- Enterprise Operations (Phase 14) ---
PARK_SLOT_COUNT=20
PAGING_MEDIA_URI=sip:page@media.vsp.internal
INTERCOM_MEDIA_URI=sip:intercom@media.vsp.internal
SUPERVISOR_MEDIA_URI=sip:supervisor@media.vsp.internal

# --- Enterprise Security (Phase 16) ---
# Rate limits (requests per RATE_LIMIT_WINDOW_SEC per client IP)
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_TELECOM_MAX=600
RATE_LIMIT_WEBRTC_MAX=120
RATE_LIMIT_PROVISIONING_MAX=60
RATE_LIMIT_ADMIN_MAX=300
RATE_LIMIT_PUBLIC_MAX=100
# Auth hardening
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_DURATION_SEC=900
AUTH_FAILURE_WINDOW_SEC=900
JWT_REFRESH_TTL_SEC=86400
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=false
PASSWORD_REQUIRE_NUMBER=false
PASSWORD_REQUIRE_SPECIAL=false
# Telecom tenant/line isolation (defaults true when VSP_ENV=production)
SECURITY_ENFORCE_TELECOM=false
SECURITY_HEADERS_ENABLED=true
SECURITY_HSTS_MAX_AGE_SEC=0
# SECURITY_CSP=default-src 'self'
REQUEST_BODY_MAX_BYTES=1mb

# --- Enterprise High Availability (Phase 17) ---
INSTANCE_ID=
REDIS_MODE=standalone
# REDIS_SENTINEL_HOSTS=sentinel1:26379,sentinel2:26379
REDIS_SENTINEL_NAME=mymaster
# REDIS_CLUSTER_NODES=redis1:6379,redis2:6379,redis3:6379
REDIS_MAX_RETRIES=3
REDIS_RETRY_MAX_ATTEMPTS=10
REDIS_CONNECT_TIMEOUT_MS=2000
REDIS_HEALTH_INTERVAL_MS=30000
# DATABASE_READ_URL=postgresql://vsp:vsp_dev_password@localhost:5433/vsp_phone?schema=public
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_RETRY_MAX_ATTEMPTS=3
POSTGRES_HEALTH_INTERVAL_MS=30000
KAMAILIO_HTTP_HOST=localhost
KAMAILIO_HTTP_PORT=8880
# KAMAILIO_NODES=kamailio1:8880,kamailio2:8880
# KAMAILIO_RPC_ENDPOINTS=http://kamailio1:8880,http://kamailio2:8880
KAMAILIO_HEALTH_INTERVAL_MS=30000
RTPENGINE_HOST=localhost
RTPENGINE_NG_PORT=2223
# RTPENGINE_NODES=rtpengine1:2223,rtpengine2:2223
RTPENGINE_HEALTH_INTERVAL_MS=30000
TRUST_PROXY=false
TRUSTED_PROXIES=
SHUTDOWN_DRAIN_MS=30000
READINESS_STRICT=false
BACKUP_LOCATION=
# Remediation C-02 — optional vendor-neutral pg_dump replacement hook
# BACKUP_POSTGRES_HOOK_CMD=/opt/vsp/scripts/backup-postgres.sh
HA_RESTORE_VERIFY_ENABLED=true
HA_CONFIG_SNAPSHOT_ON_START=false

# --- Production Platform (Phase 18) ---
RELEASE_NUMBER=
BUILD_GIT_COMMIT=
BUILD_TIMESTAMP=
BACKUP_SCHEDULE=

# --- Enterprise Migration Toolkit (Phase 19) ---
MIGRATION_SUPER_ADMIN_PERMISSION=platform:super_admin
MIGRATION_DEV_SUPER_ADMIN=true
MIGRATION_REQUIRE_READINESS=false

# --- Production Cutover & Go-Live (Phase 20) ---
# Cutover APIs reuse MIGRATION_SUPER_ADMIN_PERMISSION for Super Admin auth.
# Readiness gate enforced automatically when VSP_ENV=production.

# --- Dev secrets placeholders (Phase 1 — replace in Phase 2/8 with vault) ---
# DO NOT use these values outside local development.
DEV_JWT_SECRET=dev-only-change-me-phase1
DEV_TELECOM_HMAC_SECRET=dev-only-telecom-hmac-phase1
