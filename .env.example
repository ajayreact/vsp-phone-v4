# ==============================================================================
# VSP Phone v4 — Local development environment
# ==============================================================================
# Production:  cp .env.production.template .env  (+ fill secrets)
# Optional:     see .env.optional.template
# Reference:    docs/07-deployment/ENVIRONMENT.md
# ==============================================================================

# --- Profile ---
NODE_ENV=development
VSP_ENV=development
LOG_LEVEL=info
LOG_FORMAT=json

# --- NestJS API ---
PORT=3000
API_GLOBAL_PREFIX=api
SWAGGER_ENABLED=true
TELECOM_SERVICE_AUTH_TOKEN=
KAMAILIO_REQUIRE_SERVICE_AUTH=false
KAMAILIO_USRLOC_PERSISTENCE=memory

# --- Database / cache (host dev; Compose overrides when using docker compose) ---
POSTGRES_USER=vsp
POSTGRES_PASSWORD=vsp_dev_password
POSTGRES_DB=vsp_phone
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://vsp:vsp_dev_password@localhost:5432/vsp_phone?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Auth (lab) ---
JWT_SECRET=
JWT_ACCESS_TTL_SEC=3600
DEV_JWT_SECRET=dev-only-change-me-phase1
DEV_AUTH_EMAIL=webrtc@vsp.local
DEV_AUTH_PASSWORD=webrtc-dev
DEV_AUTH_USER_ID=00000000-0000-4000-8000-000000000001
DEV_AUTH_TENANT_ID=00000000-0000-4000-8000-000000000010

# --- Telnyx ---
TELNYX_SIP_HOST=sip.telnyx.com
TELNYX_DISPATCHER_SET=2
TELNYX_WEBHOOK_SECRET=
TELNYX_API_BASE_URL=https://api.telnyx.com/v2
TELNYX_API_KEY=
VSP_PLATFORM_INVENTORY_TENANT_ID=
# One DID ↔ One Extension (default). Set true only if multi-DID per extension is intentionally enabled.
ALLOW_MULTIPLE_DIDS_PER_EXTENSION=false

# --- Admin (browser + BFF) ---
ADMIN_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3000/api
API_INTERNAL_URL=http://localhost:3000/api
# Dev only — pick portal on localhost when hostname is not admin./app./tenant.*
# Leave unset in production single-container deploy (hostname selects portal).
# NEXT_PUBLIC_PORTAL=ops

# --- TLS (development certs) ---
TLS_ENV=development
TLS_ENABLED=false
TLS_API_CERT_FILE=./infrastructure/tls/development/live/api/fullchain.pem
TLS_API_KEY_FILE=./infrastructure/tls/development/live/api/privkey.pem
TLS_CA_FILE=./infrastructure/tls/development/live/ca/ca.crt
TLS_PROV_CERT_FILE=./infrastructure/tls/development/live/prov/fullchain.pem
TLS_PROV_KEY_FILE=./infrastructure/tls/development/live/prov/privkey.pem

# --- SIP / WebRTC lab ---
SIP_PLATFORM_DOMAIN=vsp.internal
SIP_DEFAULT_EXPIRES_SEC=3600
SIP_DEV_PASSWORD=
SIP_VAULT_JSON=
WEBRTC_WSS_URL=wss://localhost:8443
WEBRTC_ENROLL_TTL_SEC=900
WEBRTC_STUN_URL=stun:stun.l.google.com:19302
KAMAILIO_WSS_PORT=8443

# --- Docker targets (Compose) ---
API_DOCKER_TARGET=development
ADMIN_DOCKER_TARGET=development

# --- Security (development defaults) ---
SECURITY_ENFORCE_TELECOM=false
MIGRATION_DEV_SUPER_ADMIN=true

# --- Media application URIs (runtime keys — RC3 aligned) ---
QUEUE_MEDIA_URI=
IVR_MEDIA_URI=
CONFERENCE_MEDIA_URI=
VOICEMAIL_MEDIA_URI=

# --- RTPengine (production) ---
RTPENGINE_HOST=rtpengine
RTPENGINE_NG_PORT=2223
RTPENGINE_ADVERTISE=
RTPENGINE_REQUIRE_DAEMON=0

# --- Recording / object storage ---
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=vsp-recordings
S3_ACCESS_KEY=vspminio
S3_SECRET_KEY=vsp_minio_dev_password
S3_FORCE_PATH_STYLE=true
S3_REGION=us-east-1
RECORDING_STORAGE_PATH=/var/spool/rtpengine

# --- WebRTC TURN (optional — profile turn) ---
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_PASSWORD=
TURN_REALM=vspphone.com

# --- Observability (optional overlay) ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
