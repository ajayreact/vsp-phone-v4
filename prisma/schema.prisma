enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED

  @@map("subscription_status")
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID

  @@map("invoice_status")
}

enum NumberRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
  PURCHASED
  ASSIGNED

  @@map("number_request_status")
}

enum NumberReservationStatus {
  ACTIVE
  EXPIRED
  CONVERTED
  RELEASED

  @@map("number_reservation_status")
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED

  @@map("api_key_status")
}

model PlatformSettings {
