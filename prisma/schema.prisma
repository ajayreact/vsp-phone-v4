// ---------------------------------------------------------------------------
// CallSession — Platform UUID call identity aggregate (ADR-004)
// ---------------------------------------------------------------------------

model CallSession {
  id            String             @id @db.Uuid
  publicId      String             @unique @map("public_id")
  platformUuid  String             @unique @map("platform_uuid") @db.Uuid
  tenantId      String             @map("tenant_id") @db.Uuid
  fromLineId    String?            @map("from_line_id") @db.Uuid
  toLineId      String?            @map("to_line_id") @db.Uuid
  phoneNumberId String?            @map("phone_number_id") @db.Uuid
  queueId       String?            @map("queue_id") @db.Uuid
  ivrId         String?            @map("ivr_id") @db.Uuid
  conferenceId  String?            @map("conference_id") @db.Uuid
  callType      CallType           @map("call_type")
  state         CallLifecycleState @default(CREATED)
  sipCallId     String?            @map("sip_call_id")
  startedAt     DateTime?          @map("started_at") @db.Timestamptz(6)
  answeredAt    DateTime?          @map("answered_at") @db.Timestamptz(6)
  endedAt       DateTime?          @map("ended_at") @db.Timestamptz(6)
  version       Int                @default(1)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?          @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?            @map("created_by") @db.Uuid
  updatedBy     String?            @map("updated_by") @db.Uuid
  deletedBy     String?            @map("deleted_by") @db.Uuid

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  fromLine     Line?             @relation("CallSessionFromLine", fields: [fromLineId], references: [id], onDelete: Restrict)
  toLine       Line?             @relation("CallSessionToLine", fields: [toLineId], references: [id], onDelete: Restrict)
  phoneNumber  PhoneNumber?      @relation(fields: [phoneNumberId], references: [id], onDelete: Restrict)
  queue        Queue?            @relation(fields: [queueId], references: [id], onDelete: Restrict)
  ivr          IVR?              @relation(fields: [ivrId], references: [id], onDelete: Restrict)
  conference   Conference?       @relation(fields: [conferenceId], references: [id], onDelete: Restrict)
  creator      User?             @relation("CallSessionCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updater      User?             @relation("CallSessionUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  deleter      User?             @relation("CallSessionDeletedBy", fields: [deletedBy], references: [id], onDelete: Restrict)
  participants CallParticipant[]
  recordings   Recording[]

  @@index([tenantId])
  @@index([tenantId, state])
  @@index([tenantId, callType])
  @@index([tenantId, fromLineId])
  @@index([tenantId, toLineId])
  @@index([tenantId, queueId])
  @@index([tenantId, ivrId])
  @@index([tenantId, conferenceId])
  @@index([tenantId, startedAt])
  @@index([deletedAt])
  @@map("call_sessions")
}

