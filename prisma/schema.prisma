  updatedBy               String?            @map("updated_by") @db.Uuid
  deletedBy               String?            @map("deleted_by") @db.Uuid

  tenant                Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  ivr                   IVR         @relation(fields: [ivrId], references: [id], onDelete: Restrict)
  destinationLine       Line?       @relation("IVRMenuDestinationLine", fields: [destinationLineId], references: [id], onDelete: Restrict)
  destinationQueue      Queue?      @relation("IVRMenuDestinationQueue", fields: [destinationQueueId], references: [id], onDelete: Restrict)
  destinationConference Conference? @relation("IVRMenuDestinationConference", fields: [destinationConferenceId], references: [id], onDelete: Restrict)
  destinationVoicemail  Voicemail?  @relation("IVRMenuDestinationVoicemail", fields: [destinationVoicemailId], references: [id], onDelete: Restrict)
  destinationIvr        IVR?        @relation("IVRMenuDestinationIvr", fields: [destinationIvrId], references: [id], onDelete: Restrict)
  destinationRingGroup  RingGroup?  @relation("IVRMenuDestinationRingGroup", fields: [destinationRingGroupId], references: [id], onDelete: Restrict)
  creator               User?       @relation("IVRMenuCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updater               User?       @relation("IVRMenuUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  deleter               User?       @relation("IVRMenuDeletedBy", fields: [deletedBy], references: [id], onDelete: Restrict)

  @@unique([tenantId, ivrId, digit])
  @@index([tenantId])
  @@index([tenantId, ivrId])
  @@index([tenantId, destinationType])
  @@index([deletedAt])
  @@map("ivr_menus")
}

// ---------------------------------------------------------------------------
// Conference
// ---------------------------------------------------------------------------

model Conference {
  id        String           @id @db.Uuid
  publicId  String           @unique @map("public_id")
  tenantId  String           @map("tenant_id") @db.Uuid
  name      String
  code      String
  status    ConferenceStatus @default(ACTIVE)
  pin       String?
  recordingEnabled Boolean @default(false) @map("recording_enabled")
  moderatorLineId String? @map("moderator_line_id") @db.Uuid
  version   Int              @default(1)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?        @map("deleted_at") @db.Timestamptz(6)
  createdBy String?          @map("created_by") @db.Uuid
  updatedBy String?          @map("updated_by") @db.Uuid
  deletedBy String?          @map("deleted_by") @db.Uuid

  tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  creator         User?                   @relation("ConferenceCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updater         User?                   @relation("ConferenceUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  deleter         User?                   @relation("ConferenceDeletedBy", fields: [deletedBy], references: [id], onDelete: Restrict)
  participants    ConferenceParticipant[]
  callSessions    CallSession[]
  recordings      Recording[]
  ivrDestinations IVRMenu[]               @relation("IVRMenuDestinationConference")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([deletedAt])
  @@map("conferences")
}

// ---------------------------------------------------------------------------
// ConferenceParticipant
// ---------------------------------------------------------------------------

model ConferenceParticipant {
  id           String                      @id @db.Uuid
