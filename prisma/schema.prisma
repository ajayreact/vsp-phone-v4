// ---------------------------------------------------------------------------
// Recording — metadata only; media owned by RTPengine (ADR-004 / ADR-009)
// ---------------------------------------------------------------------------

model Recording {
  id              String          @id @db.Uuid
  publicId        String          @unique @map("public_id")
  tenantId        String          @map("tenant_id") @db.Uuid
  callSessionId   String          @map("call_session_id") @db.Uuid
  lineId          String?         @map("line_id") @db.Uuid
  conferenceId    String?         @map("conference_id") @db.Uuid
  status          RecordingStatus @default(PENDING)
  startedAt       DateTime?       @map("started_at") @db.Timestamptz(6)
  endedAt         DateTime?       @map("ended_at") @db.Timestamptz(6)
  durationSeconds Int?            @map("duration_seconds")
  mediaObjectKey  String?         @map("media_object_key")
  mediaFormat     String?         @map("media_format")
  version         Int             @default(1)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?       @map("deleted_at") @db.Timestamptz(6)
  createdBy       String?         @map("created_by") @db.Uuid
  updatedBy       String?         @map("updated_by") @db.Uuid
  deletedBy       String?         @map("deleted_by") @db.Uuid

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  callSession CallSession @relation(fields: [callSessionId], references: [id], onDelete: Restrict)
  line        Line?       @relation(fields: [lineId], references: [id], onDelete: Restrict)
  conference  Conference? @relation(fields: [conferenceId], references: [id], onDelete: Restrict)
  creator     User?       @relation("RecordingCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updater     User?       @relation("RecordingUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  deleter     User?       @relation("RecordingDeletedBy", fields: [deletedBy], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, callSessionId])
  @@index([tenantId, lineId])
  @@index([tenantId, conferenceId])
  @@index([tenantId, status])
  @@index([deletedAt])
  @@map("recordings")
}

