{
  "name": "vsp-phone-v4",
  "version": "4.0.0-rc1",
  "description": "Enterprise telecom platform monorepo.",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nx run-many -t build --projects=common,config,logger,api,admin",
    "build:api": "nx build api",
    "build:admin": "nx build admin",
    "serve:api": "nx serve api",
    "dev:admin": "nx dev admin",
    "lint": "nx run-many -t lint --all",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "nx run-many -t test --all",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "platform:bootstrap": "node scripts/platform/bootstrap-super-admin.cjs",
    "platform:db-init": "prisma db push",
    "superadmin:create": "npm run platform:bootstrap",
    "platform:verify-jwt": "node scripts/platform/verify-super-admin.cjs",
    "docker:up": "docker compose --env-file .env up -d --build",
    "docker:down": "docker compose --profile extras down",
    "docker:ps": "docker compose ps",
    "docker:logs": "docker compose logs -f --tail=200",
    "docker:core": "docker compose --env-file .env up -d postgres redis",
    "docker:validate": "docker compose --env-file .env config",
    "tls:generate": "node ./scripts/tls/generate-dev-certs.cjs",
    "tls:validate": "node ./scripts/tls/validate-certs.cjs",
    "tls:rotate": "powershell -ExecutionPolicy Bypass -File ./scripts/tls/rotate-dev-certs.ps1",
    "kamailio:validate": "node ./scripts/kamailio/validate-phase3.cjs",
    "rtpengine:validate": "node ./scripts/rtpengine/validate-phase4.cjs",
    "telecom:validate": "node ./scripts/telecom/validate-phase5.cjs",
    "telecom:validate:phase6": "node ./scripts/telecom/validate-phase6.cjs",
    "telecom:validate:phase7": "node ./scripts/telecom/validate-phase7.cjs",
    "telecom:validate:phase8": "node ./scripts/telecom/validate-phase8.cjs",
    "telecom:validate:phase9": "node ./scripts/telecom/validate-phase9.cjs",
    "telecom:validate:phase10": "node ./scripts/telecom/validate-phase10.cjs",
    "telecom:validate:phase11": "node ./scripts/telecom/validate-phase11.cjs",
    "telecom:validate:phase12": "node ./scripts/telecom/validate-phase12.cjs",
    "telecom:validate:phase13": "node ./scripts/telecom/validate-phase13.cjs",
    "telecom:validate:phase14": "node ./scripts/telecom/validate-phase14.cjs",
    "telecom:validate:phase15": "node ./scripts/telecom/validate-phase15.cjs",
    "telecom:validate:phase16": "node ./scripts/telecom/validate-phase16.cjs",
    "telecom:validate:phase17": "node ./scripts/telecom/validate-phase17.cjs",
    "telecom:validate:phase18": "node ./scripts/telecom/validate-phase18.cjs",
    "telecom:validate:phase19": "node ./scripts/telecom/validate-phase19.cjs",
    "telecom:validate:phase20": "node ./scripts/telecom/validate-phase20.cjs",
    "telecom:validate:remediation": "node ./scripts/telecom/validate-remediation.cjs",
    "telecom:openapi": "node ./scripts/telecom/export-openapi.cjs",
    "dev:ps1": "powershell -ExecutionPolicy Bypass -File ./scripts/dev.ps1"
  },
