    "@types/react-dom": "^19.0.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~30.3.0",
    "jest-environment-node": "~30.3.0",
