  "info": {
    "title": "VSP Phone v4 — Telecom API",
    "description": "Phase 5 contract-first NestJS telecom surface for Kamailio HTTP clients (ADR-024 shape via Wave-2 Phase 5 paths). Placeholder business logic only.",
    "version": "1.0.0-phase5",
    "contact": {}
  },
  "tags": [
    {
      "name": "telecom",
      "description": "Kamailio ↔ NestJS telecom contracts"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "telecom-service-auth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-vsp-service-auth",
        "description": "Shared telecom service credential (HMAC/token stub)"
      }
    },
    "schemas": {
      "RouteActionDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "FORK",
              "SERIAL",
              "BRIDGE_CARRIER",
              "APP_MEDIA",
              "VOICEMAIL",
              "REJECT"
            ]
          },
          "target": {
            "type": "string"
          },
          "priority": {
            "type": "number"
          }
        },
        "required": [
          "type"
        ]
      },
      "RouteRecordingDto": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "direction": {
            "type": "string",
            "enum": [
              "both",
              "caller",
              "callee"
            ]
          },
          "pauseAllowed": {
            "type": "boolean"
          }
        },
        "required": [
          "enabled",
          "pauseAllowed"
        ]
      },
      "RouteRtpDto": {
        "type": "object",
        "properties": {
          "flags": {
            "type": "string",
            "description": "Future rtpengine flags string"
          }
        }
      },
      "RouteTimersDto": {
        "type": "object",
        "properties": {
          "noAnswerSec": {
            "type": "number"
          },
          "queueRingSec": {
            "type": "number"
          },
          "ivrTimeoutSec": {
            "type": "number"
          }
        },
        "required": [
          "noAnswerSec",
          "queueRingSec",
          "ivrTimeoutSec"
        ]
      },
      "TelecomHealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "service": {
            "type": "string",
            "example": "telecom"
          },
          "mode": {
            "type": "string",
            "example": "phase5-contract"
          },
          "timestamp": {
            "type": "string"
          },
          "timeoutGuidanceMs": {
            "type": "number",
            "description": "Recommended client timeout (ms)",
            "example": 1000
          }
        },
        "required": [
          "status",
          "service",
          "mode",
          "timestamp",
          "timeoutGuidanceMs"
        ]
      },
      "AuthenticateRequestDto": {
        "type": "object",
        "properties": {
          "aor": {
            "type": "string",
            "example": "sip:1001@tenant.example.com"
          },
          "username": {
