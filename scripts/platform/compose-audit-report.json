    "apiDependsOnKamailio": true,
    "postgresDbExpanded": "vsp_phone_v4"
  },
  "dependsOn": {
    "api": {
      "postgres": {
        "condition": "service_healthy"
      },
      "redis": {
        "condition": "service_healthy"
      },
      "rtpengine": {
        "condition": "service_healthy"
      },
      "kamailio": {
        "condition": "service_healthy"
      }
    },
    "kamailio": {
      "redis": {
        "condition": "service_healthy"
      },
      "rtpengine": {
        "condition": "service_started"
      },
      "postgres": {
        "condition": "service_healthy"
      }
    }
  }
}