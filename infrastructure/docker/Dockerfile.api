# syntax=docker/dockerfile:1.7
# NestJS API — development (nx serve) and production (baked) targets

FROM node:22-bookworm-slim AS base
WORKDIR /workspace
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates curl \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json nx.json tsconfig.base.json jest.config.ts jest.preset.js ./
COPY packages ./packages
COPY apps/api ./apps/api
COPY prisma ./prisma
COPY prisma.config.ts ./

FROM base AS deps
RUN npm ci

FROM deps AS development
ENV NODE_ENV=development
ENV PORT=3000
ENV API_GLOBAL_PREFIX=api
EXPOSE 3000
CMD ["npx", "nx", "serve", "api", "--configuration=development"]

FROM deps AS build
ENV NODE_ENV=production
RUN npx prisma generate \
  && npx nx build api

FROM node:22-bookworm-slim AS production
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV API_GLOBAL_PREFIX=api
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates curl \
  && rm -rf /var/lib/apt/lists/*
COPY --from=build /workspace/dist/apps/api ./
# Prefer pruned deps when present; fall back to workspace node_modules
COPY --from=build /workspace/node_modules ./node_modules
EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=5s --start-period=25s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "main.js"]
