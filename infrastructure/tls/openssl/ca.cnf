# VSP Phone v4 — Development CA (OpenSSL)
# Used by scripts/tls/generate-dev-certs.sh

[ req ]
default_bits       = 4096
prompt             = no
default_md         = sha256
distinguished_name = dn
x509_extensions    = v3_ca

[ dn ]
C  = US
ST = Local
L  = Development
O  = VSP Phone v4
OU = Development CA
CN = VSP Phone v4 Dev Root CA

[ v3_ca ]
subjectKeyIdentifier   = hash
authorityKeyIdentifier = keyid:always,issuer
basicConstraints       = critical, CA:true
keyUsage               = critical, digitalSignature, cRLSign, keyCertSign
