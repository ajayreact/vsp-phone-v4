# VSP Phone v4 — dispatcher destinations
# Format: setid(int) destination(sip uri) flags(int,optional) priority(int) attrs(str)
#
# set=1  RTPengine control plane (informational attrs; media uses rtpengine module sock)
# set=2  Telnyx SIP trunk (Phase 8) — IP auth preferred; credentials later
#
# Flag 2 = try next destination on failure (failover hook). Ops: kamcmd dispatcher.reload

# RTPengine NG endpoints (attrs only — actual NG sock is modparam rtpengine_sock)
1 sip:rtpengine:2223 0 0 set=rtpengine;role=media

# Telnyx primary (UDP only — TCP INVITE + UDP Contact ACK breaks transaction → 32s BYE).
2 sip:sip.telnyx.com:5060;transport=udp 0 0 set=telnyx;role=primary;state=active
# 2 sip:sip.telnyx.com:5060;transport=tcp 2 10 set=telnyx;role=backup;state=active
